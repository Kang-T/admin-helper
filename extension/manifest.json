{
  "manifest_version": 3,
  "name": "Admin Helper",
  "version": "0.1.0",
  "description": "Google Workspace 관리자 도우미(Admin Helper)를 브라우저 옆 사이드 패널에서 엽니다.",
  "permissions": ["sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Admin Helper 열기"
  }
}
